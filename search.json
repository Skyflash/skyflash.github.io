---
layout: null
permalink: /search.json
---
{
    "code" : 0,
    "data" : [
    {% assign search_pages_a = site.pages | where: "layout", "page" %}
    {% assign search_pages_b = site.pages | where: "layout", "category" %}
    {% assign search_pages_c = site.pages | where: "layout", "blog-index" %}
    {% assign search_pages = search_pages_a | concat: search_pages_b | concat: search_pages_c %}
    {% for page in search_pages %}
    {% assign page_short_lang = page.lang | slice: 0, 2 | default: site.default_lang %}
    {
        "title" : {{ page.title | jsonify }},
        "url" : {{ page.url | prepend: site.baseurl | jsonify }},
        "description" : {{ page.description | default: "" | jsonify }},
        "tags" : "",
        "categories" : {{ page.category | default: "" | jsonify }},
        "lang" : {{ page_short_lang | jsonify }}
    },
    {% endfor %}
    {% for post in site.posts %}
    {% assign post_short_lang = post.lang | slice: 0, 2 | default: site.default_lang %}
    {
        "title" : {{ post.title | jsonify }},
        "url" : {{ post.url | prepend: site.baseurl | jsonify }},
        "description" : {{ post.description | default: "" | jsonify }},
        "tags" : {{ post.tags | join: ", " | jsonify }},
        "categories" : {{ post.categories | join: ", " | jsonify }},
        "lang" : {{ post_short_lang | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
    ]
}
